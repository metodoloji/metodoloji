__pycache__/
*.pyc
.pytest_cache/
.metodoloji/logs/
.metodoloji/blackboard.json
.metodoloji/blackboard.json.lock
.metodoloji/relay-note.state
.metodoloji/blackboard.json.*.tmp
# SQLite is the shipped backend: one WAL database plus its sidecars. The board
# is runtime state, never a commit (E-124).
.metodoloji/blackboard.sqlite
.metodoloji/blackboard.sqlite-wal
.metodoloji/blackboard.sqlite-shm
# Methodology state anywhere in the tree (e.g. test residue under hooks/):
# only root-level state files above are tracked-adjacent; nested trees are
# always local-only.
**/.metodoloji/logs/
**/.metodoloji/blackboard.json
**/.metodoloji/blackboard.json.lock
**/.metodoloji/relay-note.state
**/.metodoloji/blackboard.json.*.tmp
**/.metodoloji/canvas.json
**/.metodoloji/blackboard.sqlite
**/.metodoloji/blackboard.sqlite-wal
**/.metodoloji/blackboard.sqlite-shm
# Runtime lock sidecar files created while verifying experiment records
# (fail-open advisory locks); never track them.
docs/experiments/*.lock
_generated_splits/
.env

# SkillOpt training outputs
outputs/

# Personal config layer in the output-local project layer (never commit)
docs/config.user.toml
# Pre-migration legacy (kept one release for fallback reads; never written)
bmad-output/config.user.toml

# Local Node install (skills may shell out to npx tooling); lockfiles are tracked.
node_modules/

# Upstream checkouts and the interpreter that runs them (scripts/setup-upstream.sh).
# Neither is a dependency of this project: they exist only to check an export with the real tools.
vendor/
.venv-upstream/

# Optimization run state (versions, metrics) — regenerate with `python -m optimization train`
.optimization/
